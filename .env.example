# Multi-Hosting Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Server Host & Ports
SERVER_IP=127.0.0.1
PORT=5000
FRONTEND_PORT=3000
PHPMYADMIN_PORT=8080

# Security Secrets (Must be random, unique 32+ character strings in production)
JWT_SECRET=replace_with_secure_random_32_character_jwt_secret!
ENCRYPTION_KEY=replace_with_secure_random_32_character_aes_key!

# Managed Database Passwords
POSTGRES_ADMIN_PASSWORD=replace_with_secure_postgres_password
MYSQL_ADMIN_PASSWORD=replace_with_secure_mysql_password

# Initial Admin Bootstrap Account
DEFAULT_ADMIN_EMAIL=admin@multihosting.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace_with_secure_admin_password

# Cloudflare Zero Trust (Optional - for direct API automation)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_TARGET=
