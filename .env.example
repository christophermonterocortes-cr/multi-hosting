# ==============================================================================
# MULTI HOSTING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
SERVER_IP=127.0.0.1
FRONTEND_PORT=3000

# Cryptography & JWT Security
# Ensure JWT_SECRET and ENCRYPTION_KEY are set to strong random 32+ character secrets!
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key!
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_a_secure_32_byte_aes_gcm_encryption_key!

# Storage & File Paths
DATA_DIR=/app/data
DB_FILE=/app/data/db/multi_hosting.sqlite
DOCKER_SOCKET=/var/run/docker.sock

# Port Management Engine
# Allocations start at PORT_RANGE_START and increment automatically.
PORT_RANGE_START=16000
PORT_RANGE_END=20000

# Managed Database Engines (for provisioned tenant workloads)
MANAGED_POSTGRES_HOST=postgres-managed
MANAGED_POSTGRES_PORT=5432
MANAGED_POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_pass_multi_hosting

MANAGED_MYSQL_HOST=mariadb-managed
MANAGED_MYSQL_PORT=3306
MANAGED_MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=mysql_admin_pass_multi_hosting

# Default Initial Administrator Account
DEFAULT_ADMIN_EMAIL=admin@multihosting.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPass123!Secure
